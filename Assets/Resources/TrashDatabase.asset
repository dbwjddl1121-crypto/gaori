  - itemName: "\uC0DD\uC218\uBCD1"
    icon: {fileID: -831020561108044173, guid: 41a9fed220cb5b04faa36e85641668b3, type: 3}
    category: 2
    description: "\uD398\uD2B8\uBCD1, \uC6A9\uAE30 \uB4F1 \uD50C\uB77C\uC2A4\uD2F1\uC73C\uB85C
      \uB9CC\uB4E0 \uC4F0\uB808\uAE30\uC608\uC694. \uAE68\uB057\uD558\uAC8C \uBE44\uC6B0\uBA74
      \uC0C8 \uC81C\uD488\uC73C\uB85C \uB2E4\uC2DC \uD0DC\uC5B4\uB098\uC694."
    recycleTip: "\uB0B4\uC6A9\uBB3C\uC744 \uBE44\uC6B0\uACE0 \uD5F9\uAD70 \uB4A4,
      \uB77C\uBCA8\uC744 \uB5BC\uACE0 \uCC0C\uADF8\uB7EC\uB728\uB824 \uD50C\uB77C\uC2A4\uD2F1
      \uD1B5\uC5D0 \uBC84\uB824\uC694."
  - itemName: "\uC0AC\uC774\uB2E4\uBCD1"
